# Asatru PHP - App environment configuration file
# 
# Scheme:
#   name=value
# Example
#   APP_NAME="My App name"
# Datatypes:
#   string, integer, float, boolean and null (auto detected)

# App settings
APP_NAME="Asatru PHP"
APP_VERSION=1.0
APP_AUTHOR="Daniel Brendel"
APP_CONTACT="dbrendel1988@gmail.com"
APP_LABEL=""
APP_DESCRIPTION=""
APP_DEBUG=true
APP_BASEDIR=""
APP_TIMEZONE=null
APP_ENABLE_PHOTO_SHARE=false
APP_PHOTOS_PACKCOUNT=12
APP_ENABLENEWSLETTER=false
APP_MAILDRIVER=""
APP_NEWSLETTERSTATS=false
APP_NEWSLETTERCONFTIME=72
APP_NEWSLETTERCONFLIMIT=100
APP_NEWSLETTERLIMIT=5
APP_ENABLESPONSORING=false
APP_ENABLELANGFLAGS=false
APP_ENABLEASSEENON=true
APP_ENABLEPOWEREDBY=true
